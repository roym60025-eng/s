rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAllowedMediaType() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType.matches('video/.*') ||
             request.resource.contentType.matches('audio/.*') ||
             request.resource.contentType == 'application/pdf' ||
             request.resource.contentType == 'text/plain' ||
             request.resource.contentType.matches('application/vnd\\..*') ||
             request.resource.contentType == 'application/msword' ||
             request.resource.contentType == 'application/zip';
    }

    match /avatars/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
                      request.auth.uid == userId &&
                      request.resource.size <= 10 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*');
    }

    match /chat_media/{chatId}/{senderId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
                      request.auth.uid == senderId &&
                      request.resource.size <= 25 * 1024 * 1024 &&
                      isAllowedMediaType();
    }

    match /group_media/{groupId}/{senderId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
                      request.auth.uid == senderId &&
                      request.resource.size <= 25 * 1024 * 1024 &&
                      isAllowedMediaType();
    }

    match /status_media/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
                      request.auth.uid == userId &&
                      request.resource.size <= 25 * 1024 * 1024 &&
                      (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }
  }
}
